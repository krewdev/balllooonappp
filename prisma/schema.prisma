generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id
  email        String   @unique
  passwordHash String
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
}

model Booking {
  id          String    @id
  flightId    String
  passengerId String
  status      String    @default("pending")
  paid        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Flight      Flight    @relation(fields: [flightId], references: [id])
  Passenger   Passenger @relation(fields: [passengerId], references: [id])
  Review      Review?

  @@index([flightId])
  @@index([passengerId])
  @@index([status])
}

model Comment {
  id        String   @id
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Flight {
  id              String    @id
  pilotId         String
  title           String
  description     String?
  date            DateTime
  location        String
  priceCents      Int
  maxPassengers   Int
  stripeProductId String?
  stripePriceId   String?
  stripePayLink   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  Booking         Booking[]
  Pilot           Pilot     @relation(fields: [pilotId], references: [id])

  @@index([pilotId])
  @@index([date])
}

model Meister {
  id               String      @id
  email            String?     @unique
  organizationName String?
  contactName      String?
  phone            String?
  festivalName     String?
  festivalLocation String?
  festivalDate     DateTime?
  serviceTier      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  Passenger        Passenger[]
}

model Passenger {
  id                 String    @id
  email              String    @unique
  passwordHash       String?
  fullName           String?
  phone              String
  weightLbs          Int?
  location           String
  maxDistance        Int?
  emailNotifications Boolean   @default(true)
  smsNotifications   Boolean   @default(true)
  smsConsent         Boolean   @default(false)
  pilotId            String?
  meisterId          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  blocked            Boolean   @default(false)
  Booking            Booking[]
  Meister            Meister?  @relation(fields: [meisterId], references: [id])
  Pilot              Pilot?    @relation(fields: [pilotId], references: [id])
  Review             Review[]

  @@index([phone])
}

model Pilot {
  id                    String      @id
  email                 String      @unique
  passwordHash          String?
  fullName              String?
  phone                 String?
  weightLbs             Int?
  licenseNumber         String?
  licenseExpiry         DateTime?
  yearsExperience       Int?
  totalFlightHours      Int?
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceExpiry       DateTime?
  balloonRegistration   String?
  balloonCapacity       Int?
  stripeAccountId       String?
  approved              Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime
  blocked               Boolean     @default(false)
  Flight                Flight[]
  Passenger             Passenger[]
  Review                Review[]

  @@index([approved])
  @@index([stripeAccountId])
}

model PlatformSettings {
  id          String   @id
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime
  updatedBy   String?
}

model Review {
  id          String    @id
  pilotId     String
  passengerId String
  bookingId   String?   @unique
  rating      Int
  content     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Booking     Booking?  @relation(fields: [bookingId], references: [id])
  Passenger   Passenger @relation(fields: [passengerId], references: [id])
  Pilot       Pilot     @relation(fields: [pilotId], references: [id])
}

model Session {
  id        String   @id
  userId    String
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([userId])
}
